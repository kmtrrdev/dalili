# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Real data providers
SERPAPI_API_KEY=            # Google Flights / Hotels / Maps / Local / Reviews / Events / Directions / Explore / Deals
ORS_API_KEY=                # openrouteservice (HeiGIT): walking + driving time matrices
OPENTRIPMAP_API_KEY=        # less-visited sights with Wikipedia descriptions
GEOAPIFY_API_KEY=           # geocoding: coordinates, country, timezone
# Open-Meteo (weather), Frankfurter (FX) and Wikivoyage (guides) need no key.

# LLM (optional): without one, a rule-based parser handles understanding.
# auto = Azure AI Foundry if AZURE_AI_KEY + AZURE_AI_ENDPOINT are set, else Claude if ANTHROPIC_API_KEY is set.
TRAVEL_AGENT_LLM_PROVIDER=auto
AZURE_AI_KEY=
# .../openai/v1/responses uses the Responses API (reasoning models); .../chat/completions uses chat completions.
AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_AI_MODEL=gpt-5-mini
AZURE_AI_REASONING_EFFORT=low   # minimal | low | medium | high
ANTHROPIC_API_KEY=
TRAVEL_AGENT_MODEL=claude-opus-5
TRAVEL_AGENT_EFFORT=medium

# HTTP layer: cache (default) | live | replay
TRAVEL_AGENT_HTTP_MODE=cache
# SerpApi's free plan is 250 searches/month: cap live searches per chat turn.
TRAVEL_AGENT_SERPAPI_CALLS_PER_TURN=20
TRAVEL_AGENT_HOTEL_REVIEW_LOOKUPS=2

TRAVEL_AGENT_DEFAULT_ORIGIN=Cairo
TRAVEL_AGENT_MCP_TRANSPORT=inmemory
TRAVEL_AGENT_DB=travel_agent.db
